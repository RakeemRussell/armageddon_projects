# ---------- Terraform ----------
# Local .terraform directories
**/.terraform/*

# State files (can contain secrets in plaintext)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files, likely to contain passwords, keys, and other secrets
*.tfvars
*.tfvars.json

# Override files (local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output files (can contain secrets)
*tfplan*

# Transient lock info
.terraform.tfstate.lock.info

# CLI configuration files
.terraformrc
terraform.rc

# ---------- Secrets and credentials ----------
# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*

# Environment files
.env
.env.*
!.env.example

# Credential-style JSON (service account keys, exported secrets, etc.)
*secret*.json
*secrets*.json
*credential*.json
*credentials*.json
*service-account*.json
*serviceaccount*.json

# AWS local config and credentials
.aws/
credentials
aws-credentials*

# ---------- Build artifacts ----------
*.rpm
rpm_packages/
*.zip

# ---------- Python ----------
venv/
.venv/
__pycache__/
*.pyc

# ---------- Editor/OS noise ----------
.DS_Store
.idea/
.vscode/

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# lock files
*.terraform.lock.hcl.*
.terraform.lock.hcl